new file mode 100644
index 0000000..029b8ea
--- /dev/null
+++ b/tools/test_extract.py
@@ -0,0 +1,88 @@
+"""Small regression fixtures for the generator's attack-event selection."""
+import os
+from pathlib import Path
+import struct
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+from tae import Anim, Event
+import tae
+
+# Importing the extractor validates ER_FILES. These fixtures require no game
+# data: its Source is never created and only pure event selection is exercised.
+with tempfile.TemporaryDirectory() as temporary:
+    Path(temporary, "chr").mkdir()
+    previous_files = os.environ.get("ER_FILES")
+    os.environ["ER_FILES"] = temporary
+    import extract
+    if previous_files is None:
+        del os.environ["ER_FILES"]
+    else:
+        os.environ["ER_FILES"] = previous_files
+
+
+def hit(start, end, judge, source=1, condition=0):
+    return Event(1, start, end, struct.pack("<iiiBBh", 0, 0, judge, 0, source, condition))
+
+
+class HitEventTests(unittest.TestCase):
+    def test_import_id_follows_offset_in_tae_body(self):
+        data = bytearray(256)
+        data[:4] = b"TAE "
+        data[7] = 0xff
+        struct.pack_into("<i", data, 0x54, 1)
+        struct.pack_into("<q", data, 0x58, 96)
+        struct.pack_into("<qq", data, 96, 34000, 112)
+        struct.pack_into("<qqqqi", data, 112, 0, 0, 0, 160, 0)
+        struct.pack_into("<qq", data, 160, 1, 176)
+        struct.pack_into("<qi", data, 176, 224, 25034000)
+        self.assertEqual(tae.parse(data)[34000].import_from, 25034000)
+
+    def test_cross_category_imports_and_cycles(self):
+        source = extract.Source.__new__(extract.Source)
+        source.tae = {"a40": {34000: Anim(34000, import_from=25034000)},
+                      "a25": {34000: Anim(34000, [hit(.6, .7, 800)])}}
+        source.hkx = {"a025_034000": b"fixture"}
+        self.assertIs(source.anim("a40", 34000), source.tae["a25"][34000])
+        self.assertEqual(source.hkx_name("a40", 34000), "a025_034000")
+        source.tae["a25"][34000].import_from = 40034000
+        source.hkx.clear()
+        self.assertIsNone(source.anim("a40", 34000))
+        self.assertIsNone(source.hkx_name("a40", 34000))
+
+        source.tae["a40"][34000].import_from = 34000
+        source.tae["a00"] = {34000: Anim(34000)}
+        source.hkx["a000_034000"] = b"base fixture"
+        self.assertIs(source.anim("a40", 34000), source.tae["a00"][34000])
+        self.assertEqual(source.hkx_name("a40", 34000), "a000_034000")
+
+    def test_paired_hand_assignment_is_not_hit_parity(self):
+        self.assertEqual([extract.left_handed("PairedLight1", judge, False) for judge in (805, 806, 800)],
+                         [True, True, False])
+        self.assertIn("left_hand: true", extract.hit_literal(10, 13, (4, 1, 1, .08, .1, False), True, []))
+
+    def test_airborne_sequence_keeps_all_damaging_hands(self):
+        animation = Anim(34530, [hit(.2, .3, 895), hit(.3, .4, 890), hit(.5, .6, 891), hit(.1, .2, 999)])
+        source = SimpleNamespace(anim=lambda *_: animation, hkx_name=lambda *_: "fixture",
+                                 judge=lambda _variation, judge: (4, 0 if judge == 999 else 1, 1, .08, .1, False),
+                                 blade=lambda *_: [])
+        weapon = {"file": "a23", "variation": 1, "blade": ()}
+        hits = extract.air_hits(source, weapon, 34530, paired=True)
+        self.assertEqual([(hit[0], hit[1]) for hit in hits], [(6., 9.), (9., 12.), (15., 18.)])
+        self.assertEqual(["left_hand: true" in hit[-1] for hit in hits], [True, False, False])
+
+    def test_conditional_alternative_does_not_duplicate_real_hit(self):
+        animation = Anim(30000, [hit(.6, .7, 0), hit(.6, .7, 5000, condition=187)])
+        self.assertEqual(extract.hit_events(animation), [(18., 21., 0)])
+
+    def test_simultaneous_paired_hits_and_later_hits_remain_distinct(self):
+        animation = Anim(34000, [
+            hit(.6, .7, 800), hit(.6, .7, 805, source=2), hit(.8, .9, 810),
+            hit(.6, .7, 5000, condition=187), hit(.6, .7, 5006, source=2, condition=187),
+        ])
+        self.assertEqual(extract.hit_events(animation), [(18., 21., 800), (18., 21., 805), (24., 27., 810)])
+
+
+if __name__ == "__main__":
+    unittest.main()
