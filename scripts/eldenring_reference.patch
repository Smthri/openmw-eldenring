diff --git a/tools/test_bake_anims.py b/tools/test_bake_anims.py
new file mode 100644
index 0000000..122c02d
--- /dev/null
+++ b/tools/test_bake_anims.py
@@ -0,0 +1,92 @@
+"""Checks for the seal gesture continuation blend; no game assets are read."""
+import math
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import paths
+
+with patch.object(paths, "er_files", return_value=Path("unused")):
+    import bake_anims
+
+
+class ContinuationTests(unittest.TestCase):
+    def test_entrance_starts_at_windup_endpoint_and_preserves_release(self):
+        old = [((0., 1., 2.), (0., 0., 0., 1.))]
+        new = [((2., 3., 4.), (0., 1., 0., 0.))]
+        self.assertIs(bake_anims.continuation_pose(old, new, 0, 7), old)
+        self.assertIs(bake_anims.continuation_pose(old, new, 7, 7), new)
+        # Flame Sling's real cast event is frame 18: smoothing must leave
+        # both the event pose and the rest of the recovery bit-for-bit exact.
+        for frame in range(18, 63):
+            self.assertIs(bake_anims.continuation_pose(old, new, frame, 7), new)
+        position, rotation = bake_anims.continuation_pose(old, new, 3.5, 7)[0]
+        self.assertEqual(position, (1., 2., 3.))
+        self.assertAlmostEqual(sum(v * v for v in rotation), 1.)
+        self.assertAlmostEqual(rotation[1], math.sqrt(.5))
+        self.assertAlmostEqual(rotation[3], math.sqrt(.5))
+
+    def test_equivalent_quaternion_signs_do_not_invert_or_collapse(self):
+        old = [((0., 0., 0.), (0., 0., 0., 1.))]
+        new = [((0., 0., 0.), (0., 0., 0., -1.))]
+        for frame in range(1, 7):
+            self.assertEqual(bake_anims.continuation_pose(old, new, frame, 7)[0][1], old[0][1])
+
+    def test_exact_seams_need_no_second_blend(self):
+        old = [((0., 0., 0.), (0., 0., 0., 1.))]
+        new = [((1., 2., 3.), (0., 0., 1., 0.))]
+        self.assertIs(bake_anims.continuation_pose(old, new, 0, 0), new)
+
+    def test_effect_gestures_preserve_release_and_recovery(self):
+        # Release/stop frames verified from the local source TAE/HKX. The
+        # kneeling Heal skips an optional hold, and uncharged Lightning Spear
+        # needs a short entrance blend; neither may shift its release pose.
+        profiles = (("a426", 45010, 18, 65), ("a431", 45010, 15, 60),
+                    ("a434", 45011, 20, 100), ("a436", 45011, 15, 56))
+        old = [((0., 1., 2.), (0., 0., 0., 1.))]
+        new = [((2., 3., 4.), (0., 1., 0., 0.))]
+        for category, cast, release, end in profiles:
+            with self.subTest(category=category):
+                windup, blend = bake_anims.SPELL_CONTINUATIONS[category, cast]
+                self.assertIn((category, windup), bake_anims.EXTRA)
+                self.assertIn((category, cast), bake_anims.EXTRA)
+                self.assertLess(blend, release)
+                if blend:
+                    self.assertIs(bake_anims.continuation_pose(old, new, 0, blend), old)
+                for frame in range(release, end + 1):
+                    self.assertIs(bake_anims.continuation_pose(old, new, frame, blend), new)
+
+
+class LocomotionInventoryTests(unittest.TestCase):
+    def test_bow_phases_and_carries_do_not_depend_on_melee_weapon_table(self):
+        source = SimpleNamespace(hkx_name=lambda file, anim: bake_anims.clip_name(file, anim))
+        wanted = bake_anims.wanted_clips(source, ([], [], []))
+        # OpenMW owns ranged mechanics, so bow poses are deliberately outside
+        # the sandbox's melee action extraction and must survive that filter.
+        for animation in (36010, 36020, 36000):
+            self.assertIn(("a44", animation), wanted)
+        for animation in (0, *bake_anims.STANCE_LOCOMOTION, 300000,
+                          *range(320000, 320004), *range(320100, 320104), 322100):
+            self.assertIn(("a14", animation), wanted)
+        self.assertEqual(len(wanted), len(set(wanted)))
+
+    def test_one_and_two_handed_stances_keep_every_authored_gait(self):
+        source = SimpleNamespace(hkx_name=lambda file, anim: bake_anims.clip_name(file, anim))
+        weapons = [{"stance": pair} for pair in ((0, 10), (2, 12), (3, 13))]
+        wanted = bake_anims.wanted_clips(source, (weapons, [], []))
+        self.assertEqual(len(wanted), len(set(wanted)))
+        for stance in (0, 2, 3, 10, 12, 13):
+            for animation in bake_anims.STANCE_LOCOMOTION:
+                with self.subTest(stance=stance, animation=animation):
+                    self.assertIn((f"a{stance:02}", animation), wanted)
+
+    def test_missing_source_gait_is_not_invented(self):
+        source = SimpleNamespace(hkx_name=lambda file, anim: None if (file, anim) == ("a02", 20200) else "exists")
+        wanted = bake_anims.wanted_clips(source, ([{"stance": (2, 12)}], [], []))
+        self.assertNotIn(("a02", 20200), wanted)
+        self.assertIn(("a12", 20200), wanted)
+
+
+if __name__ == "__main__":
+    unittest.main()
